NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/colony_management_dev
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Public base URL of this API (links to locally stored uploads)
PUBLIC_URL=http://localhost:5000
# Background jobs: reminders, late fees, auto-billing, SLA escalation, pass expiry
ENABLE_JOBS=true
# SMS: console (prints to server log) | twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# File storage: local (dev only) | cloudinary (use on Render — its disk is wiped on deploy)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Web push. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# WhatsApp: console (prints to server log) | meta (WhatsApp Cloud API)
# Needs an approved template named WHATSAPP_TEMPLATE with two body variables ({{1}} title, {{2}} details).
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=colonyhub_alert
WHATSAPP_LANG=en
# Email: console (prints to server log) | sendgrid
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@colonyhub.local
EMAIL_FROM_NAME=ColonyHub
# Web app URL used in email links (password reset, invites)
APP_URL=http://localhost:5173
# Optional: Slack/Discord/Teams incoming webhook for unexpected errors
ERROR_WEBHOOK_URL=
